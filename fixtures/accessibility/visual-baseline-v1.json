{
  "schemaVersion": 1,
  "captureVersion": 2,
  "requiredCases": [
    {
      "name": "desktop",
      "viewport": { "width": 1280, "height": 900 },
      "deviceScaleFactor": 1,
      "forcedColors": "none"
    },
    {
      "name": "mobile",
      "viewport": { "width": 390, "height": 844 },
      "deviceScaleFactor": 1,
      "forcedColors": "none"
    },
    {
      "name": "zoom-125",
      "viewport": { "width": 1280, "height": 900 },
      "deviceScaleFactor": 1.25,
      "forcedColors": "none"
    },
    {
      "name": "forced-colors",
      "viewport": { "width": 1280, "height": 900 },
      "deviceScaleFactor": 1,
      "forcedColors": "active"
    }
  ],
  "contract": {
    "landmarks": ["main", "navigation", "complementary"],
    "minimumTargetSize": 24,
    "requireVisibleFocus": true,
    "requireNoHorizontalOverflow": true
  }
}
